# Copy to .env (gitignored) and change for anything beyond local development.
# docker-compose.yml reads these; the backend reads DATABASE_URL / CORS_ORIGINS
# from its environment (see backend/app/config.py).
POSTGRES_DB=finsight
POSTGRES_USER=finsight
POSTGRES_PASSWORD=change-me
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Where the dashboard (in the browser) reaches the API.
VITE_API_BASE_URL=http://localhost:8000
